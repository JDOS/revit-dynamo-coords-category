        }
      ],
      "Outputs": [
        {
          "Id": "391db09ef505433a99071a9d5847dd42",
          "Name": "Elements",
          "Description": "Uma classe de elemento.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Obter todos os elementos da categoria especificada no modelo."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "from Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nimport math\r\n\r\nelements = IN[0]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n# Obter localização do projeto\r\nproject_location = doc.ActiveProjectLocation\r\ntransform = project_location.GetTransform()\r\n\r\n# Listas vazias\r\ndados = []\r\ntexto= ''\r\nteste=False\r\n\r\ntabela = [[\"Nome\", \"ID\", \"X\", \"Y\", \"Z\"]]  # Cabeçalho\r\n\r\nfor elem in elements:\r\n    texto=elem.Name+\",\"+str(elem.Id)+\",\"+str(elem.Location)\r\n    texto=texto.replace(\"Point(\",\"\")\r\n    texto=texto.replace(\")\",\"\")\r\n    dados.append(texto)\r\n    elementos = texto.split(\",\")\r\n    x=elementos[2].replace(\"X = \",\"\")\r\n    y=elementos[3].replace(\" Y = \",\"\")\r\n    z=elementos[4].replace(\" Z = \",\"\")\r\n    \r\n    tabela.append([\r\n                    elementos[0],\r\n                    elementos[1],\r\n                    x,  # metros\r\n                    y,\r\n                    z,\r\n                ])\r\n\r\n   # dados.append(elem.Name)\r\n    if(\"Bordo\" in elem.Name):\r\n        teste=True\r\n    \r\n\r\n# Retornar dados\r\nOUT = tabela",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "87410634893a4a249c8a34d0382b3823",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "cfc2823df69e4b1db885b25feadaf7bf",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ba9b1cfadd254204a54dd3134cfea682",
          "Name": "OUT",
          "Description": "Resultado do script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Executa um script Python incorporado."
    },
    {
      "ConcreteType": "DSRevitNodesUI.ScheduleTypes, DSRevitNodesUI",
      "SelectedIndex": 2,
      "SelectedString": "RegularSchedule",
      "Id": "2ef8cc5ba16c4669bf55a204c4199bef",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "61f07f175ead42088d062fdcc87ba906",
          "Name": "ScheduleType",
          "Description": "O ScheduleType selecionado",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Selecione um tipo de tabela."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nimport math\r\n\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Obter localização do projeto\r\nproject_location = doc.ActiveProjectLocation\r\nsite_location = doc.SiteLocation\r\n\r\n# Transformação para coordenadas compartilhadas\r\ntransform = project_location.GetTransform()\r\n\r\ntable = IN[0]\r\n\r\n\r\n\r\ndef xyz_to_latlon(x, y, z):\r\n    # Criar ponto XYZ (em pés)\r\n    pt = XYZ(x, y, z)\r\n    \r\n    # Transformar para coordenadas compartilhadas\r\n    pt_compartilhado = transform.OfPoint(pt)\r\n    \r\n    # Obter posição geográfica\r\n    pos = project_location.GetProjectPosition(pt)\r\n    \r\n    # Converter para graus\r\n    latitude = pos.Angle * (180 / math.pi)\r\n    longitude = pos.EastWest * (180 / math.pi)\r\n    elevacao = pos.Elevation * 0.3048  # metros\r\n    \r\n    return latitude, longitude, elevacao\r\n   \r\nlinha=''\r\nfor l in table:\r\n    linha=l\r\n    teste=xyz_to_latlon(l[2],l[3],l[4])\r\n\r\nOUT = linha,teste",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a3ba9759132142b5b14c6088eae85f7c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "60854954f59f44f28e537e8a2e719ede",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "70135d8199ce42dcb9a82c53e6ed5976",
          "Name": "OUT",
          "Description": "Resultado do script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Executa um script Python incorporado."
