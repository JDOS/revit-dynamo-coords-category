        }
      ],
      "Outputs": [
        {
          "Id": "df3a4a78241342c796c88e82178bd037",
          "Name": "Geometry",
          "Description": "Geometria transformada.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Geometry.Transform@Autodesk.DesignScript.Geometry.CoordinateSystem,Autodesk.DesignScript.Geometry.CoordinateSystem",
      "Replication": "Auto",
      "Description": "Transforma esta geometria do CoordinateSystem de origem em um novo CoordinateSystem do contexto.\n\nGeometry.Transform (fromCoordinateSystem: CoordinateSystem, contextCoordinateSystem: CoordinateSystem): Geometry"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "3bb5687806bb4f57a13eed404158db80",
      "NodeType": "FunctionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "58117e153cb54de198319af856f5d851",
          "Name": "CoordinateSystem",
          "Description": "CoordinateSystem",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.CoordinateSystem.Identity",
      "Replication": "Auto",
      "Description": "Cria um CoordinateSystem como o sistema de coordenadas universais: origem em 0, 0, 0; eixo x em 1, 0, 0; eixo Y em 0 1, 0; eixo Z em 0, 0, 1\n\nCoordinateSystem.Identity ( ): CoordinateSystem"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Inputs do Dynamo\r\nelementos = IN[0]  # Lista de elementos\r\ncoordenadas = IN[1]  # Lista de coordenadas (pontos XYZ ou lista de listas [x,y])\r\n\r\n# Documento ativo\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Iniciar transação\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nresultados = []\r\n\r\nfor i, elem in enumerate(elementos):\r\n    try:\r\n        # Obter coordenadas X e Y\r\n        if hasattr(coordenadas[i], 'X'):  # Se for um ponto XYZ\r\n            x_valor = coordenadas[i].X\r\n            y_valor = coordenadas[i].Y\r\n        else:  # Se for uma lista [x, y]\r\n            x_valor = coordenadas[i][0]\r\n            y_valor = coordenadas[i][1]\r\n        \r\n        # Definir parâmetro X\r\n        param_x = elem.LookupParameter(\"x_arvore\")\r\n        if param_x and not param_x.IsReadOnly:\r\n            param_x.Set(x_valor)\r\n        \r\n        # Definir parâmetro Y\r\n        param_y = elem.LookupParameter(\"y_arvore\")\r\n        if param_y and not param_y.IsReadOnly:\r\n            param_y.Set(y_valor)\r\n        \r\n        resultados.append(\"Sucesso\")\r\n    except Exception as e:\r\n        resultados.append(str(e))\r\n\r\n# Finalizar transação\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = resultados",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f26969473fcd4f76ad5adeff8e8703eb",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "bd56eac906c2469db4ec91a86bcea067",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0992c96bd41b4f5eba8e20ab000f6c83",
