    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Criar ponto a partir de coordenadas\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import Point\r\n\r\ntable = IN[0]\r\ndel table[0]\r\nlinha=''\r\ncoords=[]\r\nfor l in table:\r\n    linha=l\r\n    coords.append(Point.ByCoordinates(float(l[2]),float(l[3]),float(l[4])))\r\n\r\nOUT = coords\r\n",
