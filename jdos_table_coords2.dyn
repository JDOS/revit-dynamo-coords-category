    {
      "ConcreteType": "DSRevitNodesUI.ElementsOfCategory, DSRevitNodesUI",
      "Id": "05894bfc85314999a13693f932382b5c",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "6c1ab55ff8904779b6a2a47dc0150d91",
          "Name": "Category",
          "Description": "Categoria",
